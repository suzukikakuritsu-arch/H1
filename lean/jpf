noncomputable section
open_locale classical big_operators

import Mathlib.LinearAlgebra.Matrix.PerronFrobenius
import Mathlib.LinearAlgebra.JordanNormalForm
import Mathlib.Analysis.NormedSpace.Basic

universes u

-- ----------------------
-- 比率定義
-- ----------------------
def φ : ℝ := (1 + Real.sqrt 5) / 2
def ψ : ℝ := (1 + Real.sqrt 7) / 2
def χ : ℝ := (1 + Real.sqrt 13) / 2

def v_ratio (γ : ℝ) : Fin 2 → ℝ := fun i => if i = 0 then 1 else γ - 1

-- ----------------------
-- Jordan 分解による累乗挙動
-- ----------------------
lemma jordan_power_limit
  (M : Matrix ℝ (Fin 2) (Fin 2))
  (γ : ℝ)
  (h_irred : Irreducible M)
  (h_dom : dominantEigenvalue M = γ)
  (n0 : Fin 2 → ℝ) (hn0 : ∥n0∥ ≠ 0) :
  ∃ c > 0, tendsto (λ t : ℕ, ∥(M ^ t) n0 / γ^t - c • v_ratio γ∥) at_top (𝓝 0) := by
  -- Step 1: Jordan 正準形を取得
  let J := (M.jordanForm h_dom).J
  let P := (M.jordanForm h_dom).P
  have h_inv : IsUnit (P.toLinearMap) := (M.jordanForm h_dom).invertible
  -- Step 2: 初期ベクトルを基底に展開
  let x0 := P.toLinearMap⁻¹ n0
  -- Step 3: Jordan ブロックに沿った累乗挙動
  -- 2x2 の irreducible 行列なので 1つの最大固有値 γ が支配
  let c := x0 0 -- 固有ベクトル成分
  have hc : c > 0 := by
    -- 初期ベクトルが非ゼロなので成分 c > 0 とできる
    sorry
  -- Step 4: γ^t で正規化して極限を固定
  have lim0 : tendsto (λ t : ℕ, (M ^ t) n0 / γ^t - c • v_ratio γ) at_top (𝓝 0) := by
    -- Jordan 分解 + Perron-Frobenius 定理適用
    sorry
  exact ⟨c, hc, lim0⟩

-- ----------------------
-- 統合定理: φ/ψ/χ 系列対応
-- ----------------------
theorem suzuki_golden_multi_ratio_jordan
  (M : Matrix ℝ (Fin 2) (Fin 2))
  (γ : ℝ) -- φ, ψ, χ
  (h_nonneg : ∀ i j, 0 ≤ M i j)
  (h_irred : Irreducible M)
  (h_dom : dominantEigenvalue M = γ)
  (n0 : Fin 2 → ℝ) (hn0 : ∥n0∥ ≠ 0) :
  ∃ c > 0, tendsto (λ t : ℕ, ∥(M ^ t) n0 / γ^t - c • v_ratio γ∥) at_top (𝓝 0) := by
  exact jordan_power_limit M γ h_irred h_dom n0 hn0

