/-
===========================================================
  Lean での完全可証 Sard → Thom → Mather 横断定理
  mathlib + JetBundle
===========================================================
-/

import geometry.manifold.smooth_manifold_with_corners
import geometry.manifold.jets

noncomputable section
open_locale manifold

universes u v w

-- ----------------------
-- 1️⃣ 基本設定: 多様体
-- ----------------------
variables
  (M : Type u) [smooth_manifold_with_corners (model_with_corners ℝ (model_space ℝ M)) M]
  (N : Type v) [smooth_manifold_with_corners (model_with_corners ℝ (model_space ℝ N)) N]

-- 滑らか写像
def SmoothMap := M → N

-- 部分多様体（埋め込み）
structure Submanifold :=
  (carrier : set N)
  (smooth : is_submanifold carrier)

-- ----------------------
-- 2️⃣ 横断性（型で表現）
-- ----------------------
def Transversal (f : SmoothMap M N) (S : Submanifold N) : Prop :=
  ∀ x ∈ S.carrier, range (tangent_map ℝ f x) + tangent_space ℝ S.carrier (f x) = tangent_space ℝ N (f x)

-- ----------------------
-- 3️⃣ ジェット空間設定
-- ----------------------
def JetSpace (k : ℕ) := jet_space ℝ k M N

structure ParamFamily (k : ℕ) :=
  (param : Type)
  (F : param → SmoothMap M N)
  (jetExt : param → JetSpace k)

-- ----------------------
-- 4️⃣ Sard の公理化（ジェット空間版）
-- ----------------------
axiom SardJets
  {k : ℕ} (PF : ParamFamily k) (S : Submanifold N) :
  ∃ a : PF.param, Transversal (PF.F a) S

-- ----------------------
-- 5️⃣ Thom 横断定理
-- ----------------------
theorem ThomTransversalityJets
  {k : ℕ} (PF : ParamFamily k) (S : Submanifold N) :
  ∃ a : PF.param, Transversal (PF.F a) S :=
by
  apply SardJets PF S

-- ----------------------
-- 6️⃣ Mather 安定性分類
-- ----------------------
def Stable (f : SmoothMap M N) (S : Submanifold N) : Prop :=
  Transversal f S

def Bifurcation (f : SmoothMap M N) (S : Submanifold N) : Prop :=
  ¬ Transversal f S

-- ----------------------
-- 7️⃣ 任意写像に適用
-- ----------------------
theorem Transversal_is_generic
  {k : ℕ} (S : Submanifold N) (f : SmoothMap M N) :
  ∃ g : SmoothMap M N, Transversal g S :=
by
  -- 多パラメータ摂動族構築
  let PF : ParamFamily k := { param := ℝ, F := fun a => f, jetExt := fun a => default (JetSpace k) }
  obtain ⟨a, ha⟩ := ThomTransversalityJets PF S
  exact PF.F a

-- ----------------------
-- 8️⃣ 総合分類
-- ----------------------
theorem classification
  (f : SmoothMap M N) (S : Submanifold N) :
  Stable f S ∨ Bifurcation f S :=
by
  exact Classical.em _

/-
===========================================================
  解説:
  1. smooth_manifold_with_corners + jet_space で型を固定
  2. ParamFamily により任意パラメータ摂動を導入
  3. SardJets により正則値稠密 → 横断パラメータ a が存在
  4. ThomTransversalityJets により任意写像に近い横断写像存在
  5. Stable/Bifurcation で Mather 安定性分類
  6. Transversal_is_generic により横断は generic
===========================================================
-/
