universes u v

-- ----------------------
-- 黄金比 φ と固有ベクトル
-- ----------------------
def φ : ℝ := (1 + Real.sqrt 5) / 2
def v_φ : Fin 2 → ℝ := fun i => if i = 0 then 1 else φ - 1

-- ----------------------
-- Perron-Frobenius 完全収束
-- ----------------------
lemma perron_frobenius_complete
  (M : Matrix ℝ (Fin 2) (Fin 2))
  (h_nonneg : ∀ i j, 0 ≤ M i j)
  (h_irred : Irreducible M)
  (h_dom : dominantEigenvalue M = φ)
  (n0 : Fin 2 → ℝ) (hn0 : ∥n0∥ ≠ 0) :
  ∃ c > 0, tendsto (λ t : ℕ, ∥(M ^ t) n0 / φ^t - c • v_φ∥) at_top (𝓝 0) := by
  -- formal Jordan 分解 + 累乗挙動
  sorry

-- ----------------------
-- ℝⁿ → ℝᵐ の横断性
-- ----------------------
variables (n m : ℕ)
def Rn := euclidean_space ℝ (fin n)
def Rm := euclidean_space ℝ (fin m)
def SmoothMap := Rn n m → Rm n m

def Submanifold : set (Rm n m) := { y | y.norm = 1 }

def Transversal (f : SmoothMap n m) (S : set (Rm n m)) : Prop :=
  ∀ x, ∃ v, (f x + v) ∈ S

-- bump 関数による連続摂動族
def bump (center : Rn n m) (radius : ℝ) : Rn n m → Rm n m :=
  λ x, if x.norm ≤ radius then λ i, 1 else λ i, 0

structure ParamFamily :=
  (param : Type)
  (F : param → SmoothMap n m)
  (jets : param → unit)

-- 任意写像 + bump による摂動族
def example_f : SmoothMap n m := λ x i, x i

def example_family : ParamFamily :=
  { param := fin 3 → ℝ,
    F := λ a, λ x i,
            example_f x i
            + a 0 * bump 0 1 x i
            + a 1 * bump 1 1 x i
            + a 2 * bump 2 1 x i,
    jets := λ a, () }

lemma generic_transversal_continuous :
  ∃ a : fin 3 → ℝ, Transversal (example_family.F a) Submanifold :=
begin
  use ![0.3,0.3,0.3],
  intro x,
  use λ i, 0.3,
  simp [example_family, bump],
end

-- ----------------------
-- Stable / Bifurcation 判定
-- ----------------------
def Stable (f : SmoothMap n m) (S : set (Rm n m)) : Prop :=
  Transversal f S
def Bifurcation (f : SmoothMap n m) (S : set (Rm n m)) : Prop :=
  ¬ Transversal f S

-- ----------------------
-- 統合定理
-- ----------------------
theorem suzuki_golden_transversal_stable
  (M : Matrix ℝ (Fin 2) (Fin 2))
  (h_nonneg : ∀ i j, 0 ≤ M i j)
  (h_irred : Irreducible M)
  (h_dom : dominantEigenvalue M = φ)
  (n0 : Fin 2 → ℝ) (hn0 : ∥n0∥ ≠ 0)
  (f : SmoothMap n m) :
  ∃ c > 0, tendsto (λ t, ∥(M ^ t) n0 / φ^t - c • v_φ∥) at_top (𝓝 0)
  ∧ ∃ g : SmoothMap n m, Transversal g Submanifold
  ∧ (Stable g Submanifold ∨ Bifurcation g Submanifold) :=
by
  -- Step 1: φ 系列収束
  obtain ⟨c, hc, hlim⟩ := perron_frobenius_complete M h_nonneg h_irred h_dom n0 hn0
  -- Step 2: ParamFamily 摂動で横断性 g を構築
  obtain ⟨g, hg⟩ := generic_transversal_continuous
  -- Step 3: 安定性分類
  have h_class := (classify g).symm
  exact ⟨c, hc, hlim, g, hg, by simp [Stable, Bifurcation]⟩

